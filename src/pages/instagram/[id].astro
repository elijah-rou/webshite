---
import { Image } from 'astro:assets';
import Terminal from '../../layouts/Terminal.astro';
import Nav from '../../components/Nav.astro';
import { read_photos, type Photo } from '../../lib/photos';
export function getStaticPaths() {
    const photos = read_photos();
    return photos.map((photo, index) => ({
        params: { id: photo.id },
        props: { photo, next: photos[index + 1], previous: photos[index - 1] },
    }));
}
interface Props { photo: Photo; next: Photo | undefined; previous: Photo | undefined }
const { photo, next, previous } = Astro.props;
const items = [
    ...(next ? [{ label: 'Next photo', href: `/instagram/${next.id}/` }] : []),
    ...(previous ? [{ label: 'Previous photo', href: `/instagram/${previous.id}/` }] : []),
    ...(photo.instagram ? [{ label: 'View on Instagram', href: photo.instagram }] : []),
];
---
<Terminal title={photo.title} section="photos" back="/instagram/" description={photo.alt}>
    <figure class="photo-view">
        <Image src={photo.image} alt={photo.alt} widths={[800, 1600, 2400]} sizes="90vw" loading="eager" />
        <figcaption>{photo.title}</figcaption>
    </figure>
    {items.length > 0 && <Nav label="Photo" items={items} />}
</Terminal>
