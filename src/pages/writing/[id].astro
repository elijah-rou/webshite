---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Terminal from '../../layouts/Terminal.astro';
export async function getStaticPaths() {
    const posts = await getCollection('writing', ({ data }) => !data.draft);
    return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'writing'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Terminal title={post.data.title} section="writing" back="/writing/" description={post.data.description}>
    <article class="article">
        <h1>{post.data.title}</h1>
        <p class="article-meta">
            <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
            {post.data.category && <span>{post.data.category}</span>}
        </p>
        <div class="prose"><Content /></div>
    </article>
</Terminal>
