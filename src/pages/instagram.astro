---
import { Image } from 'astro:assets';
import Terminal from '../layouts/Terminal.astro';
import { read_posts } from '../lib/photos';
const posts = read_posts();
---
<Terminal title="Photos" section="photos">
    <h1>PHOTOS</h1>
    {posts.length > 0
        ? <div class="photo-grid" data-photo-grid>
            {posts.map((post, index) => <a href={`/instagram/${post.id}/`}
                aria-label={post.images.length > 1 ? `${post.title}, ${post.images.length} images` : post.title}>
                <span class="photo-thumb">
                    <Image src={post.cover} alt="" widths={[240, 480]} sizes="240px"
                        loading={index < 6 ? 'eager' : 'lazy'} />
                    {post.images.length > 1 && <span class="photo-count" aria-hidden="true">{post.images.length}</span>}
                </span>
                <span class="photo-tile-caption" aria-hidden="true">{post.title}</span>
            </a>)}
        </div>
        : <p class="prose">No photos yet.</p>}
</Terminal>
