---
import { Image } from 'astro:assets';
import Terminal from '../layouts/Terminal.astro';
import { INSTAGRAM_PROFILE, read_photos } from '../lib/photos';
const photos = read_photos();
---
<Terminal title="Photos" section="photos">
    <h1>PHOTOS</h1>
    {photos.length > 0
        ? <div class="photo-grid" data-photo-grid>
            {photos.map((photo, index) => <a href={`/instagram/${photo.id}/`} aria-label={photo.title}>
                <Image src={photo.image} alt="" widths={[240, 480]} sizes="240px"
                    loading={index < 6 ? 'eager' : 'lazy'} />
            </a>)}
        </div>
        : <p>No photos yet.</p>}
    <a class="text-link" href={INSTAGRAM_PROFILE}>instagram.com/eli_takes_photos</a>
</Terminal>
