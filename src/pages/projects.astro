---
import Terminal from '../layouts/Terminal.astro';
---
<Terminal title="Projects" section="projects">
    <div class="file-path">USER://ELIJAH/PROJECTS <span>ARCHIVE OPEN</span></div>
    <section class="archive-intro">
        <p class="eyebrow">THINGS BUILT. THINGS LEARNED.</p>
        <h1>PROJECT LOG</h1>
        <p class="hero-description">Experiments, useful tools,<br />and things made out of curiosity.</p>
    </section>
    <div class="empty-archive">
        <span class="archive-symbol" aria-hidden="true">[ + ]</span>
        <h2>THE ARCHIVE IS JUST GETTING STARTED.</h2>
        <p>Project write-ups will appear here as they’re ready.</p>
        <a href="/writing/" class="terminal-link">[ VISIT THE WRITING LOG ] ↗</a>
    </div>
</Terminal>
