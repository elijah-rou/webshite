---
import Terminal from '../layouts/Terminal.astro';
import portrait from '../assets/portrait.png';
// Placeholder copy drawn from the résumé and project list, to be replaced by Elijah.
// The portrait is generated by scripts/portrait.mjs from his LinkedIn photo.
const record = [
    ['NAME', 'Elijah Roussos'],
    ['LOCATION', 'New York, NY · Cape Town, ZA'],
    ['ROLE', 'Founding engineer, Cerebrium, 2022 to 2026'],
    ['EDUCATION', 'MEng ECE, Cornell · BSc (Hons) CS, UCT'],
    ['LANGUAGES', 'Go, Python, TypeScript, Rust, Zig'],
    ['INSTRUMENT', 'Gibson Les Paul Special'],
];
---
<Terminal title="About" section="about">
    <h1>ABOUT</h1>
    <section class="personnel" aria-label="Personnel record">
        <figure class="portrait">
            <img src={portrait.src} width={portrait.width} height={portrait.height}
                alt="Elijah Roussos, rendered in green terminal pixels" />
            <figcaption>IMG-0001 · ROUSSOS, E.</figcaption>
        </figure>
        <dl class="personnel-record">
            {record.map(([field, value]) => <div><dt>{field}</dt><dd>{value}</dd></div>)}
        </dl>
    </section>
    <div class="prose">
        <p>
            I'm Elijah, a software engineer splitting my time between New York and Cape Town. I build the infrastructure that runs
            machine-learning workloads. For four years I was a founding engineer at Cerebrium, working
            across its serverless GPU platform: execution, request routing, storage and the control plane.
        </p>
        <p>
            Before that I studied computer science and game development at the University of Cape Town,
            built trading systems at Invictus Capital, and took a master's in electrical and computer
            engineering at Cornell, where I simulated ant colonies and trained them with neuroevolution.
        </p>
        <p>
            Outside work I write side projects in Zig, Go and Rust, several of them terminal tools; the
            Projects screen lists them. I play a Gibson Les Paul Special, make music in FL Studio, Bitwig and
            Logic, and post photographs as <a href="https://www.instagram.com/eli_takes_photos/">@eli_takes_photos</a>.
        </p>
    </div>
</Terminal>
