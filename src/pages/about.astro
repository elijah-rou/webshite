---
import Terminal from '../layouts/Terminal.astro';
import portrait from '../assets/portrait.png';
// Placeholder copy from things Elijah has shared publicly, to be replaced by him.
// The portrait is generated by scripts/portrait.mjs from his LinkedIn photo.
const record = [
    ['NAME', 'Elijah Roussos'],
    ['LOCATION', 'New York, NY · Cape Town, ZA'],
    ['EDUCATION', 'MEng ECE, Cornell · BSc (Hons) CS, UCT'],
];
---
<Terminal title="About" section="about">
    <h1>ABOUT</h1>
    <section class="personnel" aria-label="Personnel record">
        <figure class="portrait">
            <img src={portrait.src} width={portrait.width} height={portrait.height}
                alt="Elijah Roussos, rendered in green terminal pixels" />
            <figcaption>IMG-0001 · ROUSSOS, E.</figcaption>
        </figure>
        <div class="personnel-body">
            <dl class="personnel-record">
                {record.map(([field, value]) => <div><dt>{field}</dt><dd>{value}</dd></div>)}
            </dl>
            <div class="prose">
        <p>I'm Elijah. I split my time between New York and Cape Town, and most of my days go to programming.</p>
        <p>
            Away from the keyboard I play guitar, a Gibson Les Paul Special, and make music in FL Studio,
            Bitwig and Logic. I also take photos; they go up on Instagram
            as <a href="https://www.instagram.com/eli_takes_photos/">@eli_takes_photos</a> and on the Photos screen here.
        </p>
        <p>
            Each December I use Advent of Code to learn a new language: Elixir, then Zig, then OCaml. And I
            play games, which is how this site ended up looking like a terminal from Fallout 3.
        </p>
            </div>
        </div>
    </section>
</Terminal>
