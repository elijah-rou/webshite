---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Terminal from '../../layouts/Terminal.astro';
export async function getStaticPaths() {
    const talks = await getCollection('talks');
    return talks.map(talk => ({ params: { id: talk.id }, props: { talk } }));
}
interface Props { talk: CollectionEntry<'talks'> }
const { talk } = Astro.props;
const { Content } = await render(talk);
// The schema guarantees the id. The no-cookie host sets no cookies until playback.
const video_id = new URL(talk.data.video).searchParams.get('v');
const embed = `https://www.youtube-nocookie.com/embed/${video_id}?autoplay=1&rel=0`;
---
<Terminal title={talk.data.title} section="talks" back="/talks/" description={talk.data.event} hints={['ENTER PLAY']}>
    <article class="article">
        <h1>{talk.data.title}</h1>
        <p class="article-meta">
            <time datetime={talk.data.date.toISOString()}>{talk.data.date.toISOString().slice(0, 10)}</time>
            <span>{talk.data.event}</span>
        </p>
        <div class="talk-video">
            <a href={talk.data.video} data-video-embed={embed} data-video-title={talk.data.title}>
                <!-- The zoom magnifies the screen to nearly the window's width. -->
                <Image src={talk.data.poster} alt="" widths={[640, 960, 1280]} sizes="100vw" loading="eager" />
                <span class="talk-play">&gt; PLAY RECORDING</span>
            </a>
        </div>
        <div class="prose project-summary"><Content /></div>
    </article>
</Terminal>
