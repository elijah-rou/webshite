---
import Terminal from '../layouts/Terminal.astro';
import Nav from '../components/Nav.astro';
const items = [
    { label: 'About', href: '/about/' },
    { label: 'Resume', href: '/resume/' },
    { label: 'Projects', href: '/projects/' },
    { label: 'Talks', href: '/talks/' },
    { label: 'Writing (in construction)', href: '/writing/', disabled: true },
    { label: 'Music (in construction)', href: '/music/', disabled: true },
    { label: 'Photos', href: '/instagram/' },
];
---
<Terminal title="Home" section="home">
    <div class="hack-root" data-intro-root></div>
    <p class="terminal-greeting">Welcome to Eli's Terminal. Please select an entry.</p>
    <Nav items={items} />
</Terminal>
