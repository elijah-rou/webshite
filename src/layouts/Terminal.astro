---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/vt323/400.css';
import '../styles/terminal.css';
interface Props {
    title: string;
    section: 'home' | 'about' | 'writing' | 'projects' | 'music' | 'photos';
    description?: string;
    back?: string;
}
const { title, section, description = 'Elijah Roussos. Code, writing and music.', back = '/' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-effects="on">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#11120e" />
        <title>{title} | Elijah Roussos</title>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <ClientRouter />
    </head>
    <body transition:animate="none">
        <a class="skip-link" href="#content">Skip to content</a>
        <div class="terminal-station">
            <div class="monitor">
                <img class="monitor-housing" src="/images/terminal-housing.png" alt=""
                    width="1374" height="1145" fetchpriority="high" />
                <span class="jack-socket" data-jack-socket aria-hidden="true"></span>
                <div class="screen">
                    <div class="screen-glass" aria-hidden="true"></div>
                    <div class="screen-scroll">
                        <header class="system-header">
                            <a href="/" aria-label="Elijah Roussos, terminal home">ELIJAH ROUSSOS UNIFIED OPERATING SYSTEM</a>
                            <p>COPYRIGHT {year} ELIJAH ROUSSOS</p>
                        </header>
                        <main id="content" tabindex="-1" data-section={section}><slot /></main>
                        {section === 'home' && <div class="command-prompt" aria-hidden="true">&gt;<span class="cursor">█</span></div>}
                    </div>
                    <div class="screen-bottom">
                        {section !== 'home' && <a class="back-link" data-back href={back}>&gt; Back</a>}
                        <div data-terminal-controls>
                            <div class="terminal-controls" aria-hidden="true">
                                <span>[SOUND ON]</span>
                                <span>[CRT ON]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <p class="keyboard-hint" aria-hidden="true">
                <span>↑ ↓ SELECT</span><span>ENTER OPEN</span>{section !== 'home' && <span>ESC BACK</span>}
            </p>
        </div>
        <div data-guitar-jack></div>
        <script>import '../scripts/terminal.tsx';</script>
    </body>
</html>
