---
interface Props { section: string }
const { section } = Astro.props;
const navigation = [
    { label: 'PROFILE', path: '/', section: 'home' },
    { label: 'WRITING', path: '/writing/', section: 'writing' },
    { label: 'PROJECTS', path: '/projects/', section: 'projects' },
    { label: 'MUSIC', path: '/music/', section: 'music' },
    { label: 'PHOTOS', path: '/instagram/', section: 'photos' },
];
---
<nav class="navigation" aria-label="Main navigation">
    {navigation.map((item, index) => <a href={item.path}
        aria-current={section === item.section ? 'page' : undefined}>
        <span class="nav-index">0{index + 1}</span><span>{item.label}</span>
    </a>)}
</nav>
