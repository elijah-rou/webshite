---
interface Props { items: { label: string; href: string }[]; label?: string }
const { items, label = 'Main menu' } = Astro.props;
---
<div data-terminal-menu aria-label={label}>
    <nav class="terminal-menu" aria-label={label}>
        {items.map((item, index) => <a href={item.href} data-label={item.label} data-selected={index === 0}>
            <span aria-hidden="true">&gt; </span>{item.label}
        </a>)}
    </nav>
</div>
